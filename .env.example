# --- Redação das mensagens (opcional: sem chave, ou com --sem-ia, usa o texto padrão) ---
ANTHROPIC_API_KEY=
EM_DIA_MODELO=claude-opus-5-5

# --- Remetente do e-mail (veja a skill configurar-remetente) ---
# console = não envia, grava em saida/emails/ | resend = envio real
EM_DIA_EMAIL_PROVEDOR=console
# Endereço de um domínio próprio verificado no provedor. Não use gmail/hotmail.
EM_DIA_REMETENTE_EMAIL=avisos@seudominio.com.br
EM_DIA_REMETENTE_NOME=Wavern
# Para onde vão as respostas do cliente (ex. caixa do escritório).
EM_DIA_RESPONDER_PARA=contato@seudominio.com.br
# Página onde a pessoa para de receber os avisos. Obrigatório para envio real.
EM_DIA_LINK_DESCADASTRO=https://wavern.com.br/preferencias/avisos
EM_DIA_ASSINATURA=Equipe Wavern

# Chave do Resend (https://resend.com/api-keys), com permissão só de envio.
RESEND_API_KEY=
